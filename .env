VITE_API_URL=http://localhost:5000/api/v1

# Google OAuth (components/GoogleAuthButton.jsx) — Clerk was removed in favor
# of a direct Google Identity Services flow (see main.jsx / GoogleAuthButton.jsx
# / authController.js googleLogin). This is the OAuth Client ID's public half
# only — safe to ship in a frontend bundle; the matching client secret lives
# only in the backend's own .env (gravysyncro-backend/.env, GOOGLE_CLIENT_SECRET)
# and must never be exposed here. Without this var, GoogleAuthButton fails soft
# (logs an error, leaves the button permanently disabled) rather than crashing
# the page — see its useEffect for that guard.
VITE_GOOGLE_CLIENT_ID=797317365472-0l3fgppve28a9k467rr6tdqf09jtap4a.apps.googleusercontent.com
